{
  "name": "escala-monte-siao",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "db:apply": "wrangler d1 migrations apply escala-monte-siao --local",
    "db:apply:remote": "wrangler d1 migrations apply escala-monte-siao --remote",
    "db:create": "wrangler d1 create escala-monte-siao",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@mmmike/web-push": "^1.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.7.2",
    "lucide-react": "^0.487.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.4.0",
    "tailwind-merge": "^3.2.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.13.0",
    "@cloudflare/workers-types": "^5.20260921.1",
    "@tailwindcss/vite": "^4.1.3",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.1.3",
    "typescript": "^5.8.2",
    "vite": "^6.2.3",
    "wrangler": "^4.137.0"
  }
}
